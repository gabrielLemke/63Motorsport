# ==========================================
# Configurações do Ambiente Geral - 63 Motorsport
# ==========================================
NODE_ENV=development
PORT=3333

# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
DB_USER=motorsport_user
DB_PASSWORD=motorsport_secure_password_2026
DB_NAME=motorsport_db
DB_PORT=5432
DATABASE_URL="postgresql://motorsport_user:motorsport_secure_password_2026@localhost:5432/motorsport_db?schema=public"

# ==========================================
# Segurança & Redes
# ==========================================
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# ==========================================
# WhatsApp & Atendimento da Oficina
# ==========================================
# Formato internacional sem espaços ou símbolos (ex: 5547999999999)
WHATSAPP_PHONE=5547999999999

# ==========================================
# Frontend (Vite)
# ==========================================
VITE_API_URL=http://localhost:3333
VITE_WHATSAPP_PHONE=5547999999999
